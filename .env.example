# Copy to .env (gitignored) and fill in real values.
# For local `docker compose up`, this file should live next to docker-compose.yml.
# On the Pi, the deploy workflows point at a persistent copy outside the git checkout —
# see DEPLOYMENT.md.

FPL_DB_USER=fpl_user
FPL_DB_PASSWORD=changeme

# Required at boot in every profile (base application.properties has no default) even
# though the draft league feature doesn't use this client yet.
FOOTBALL_API_USERNAME=changeme
FOOTBALL_API_PASSWORD=changeme
FOOTBALL_API_KEY=changeme
